service surfaceflinger /system/bin/surfaceflinger_HYBRIS_DISABLED
    override
    disabled

service cameraserver /system/bin/cameraserver_HYBRIS_DISABLED
    override
    disabled

service audioserver /system/bin/audioserver_HYBRIS_DISABLED
    override
    disabled

# logd enabled so Android logcat works for HWC/composer debugging.
# Re-disable once display bring-up is complete.

service netd /system/bin/netd_HYBRIS_DISABLED
    override
    disabled

service installd /system/bin/installd_HYBRIS_DISABLED
    override
    disabled

service update_engine /system/bin/update_engine_HYBRIS_DISABLED
    override
    disabled

service lmkd /system/bin/lmkd_HYBRIS_DISABLED
    override
    disabled

service storaged /system/bin/storaged_HYBRIS_DISABLED
    override
    disabled

service bootanim /system/bin/bootanimation_HYBRIS_DISABLED
    override
    disabled

service gpu /system/bin/gpuservice_HYBRIS_DISABLED
    override
    disabled

service mediaextractor /system/bin/mediaextractor_HYBRIS_DISABLED
    override
    disabled

service mediametrics /system/bin/mediametrics_HYBRIS_DISABLED
    override
    disabled

service bpfloader /system/bin/netbpfload_HYBRIS_DISABLED
    override
    disabled

# vold crashes on Android 15 (checkCallingPermission removed from libbinder).
# SailfishOS manages its own storage — vold is not needed.
service vold /system/bin/vold_HYBRIS_DISABLED
    override
    disabled
