[Unit]
Description=Droid mount for /vendor
DefaultDependencies=no
Before=vendor-bt_firmware.mount vendor-dsp.mount vendor-firmware_mnt.mount local-fs.target systemd-modules-load.service
# Cold-boot only: see system_root.mount / kaos-droid-hal-init.service.
ConditionPathExists=!/etc/kaos-overlay-active

[Mount]
What=/run/droid/vendor
Where=/vendor
Type=ext4
Options=ro
TimeoutSec=5

[Install]
WantedBy=local-fs.target
