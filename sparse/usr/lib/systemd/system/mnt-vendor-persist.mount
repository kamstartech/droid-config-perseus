[Unit]
Description=Droid mount for /mnt/vendor/persist
Before=local-fs.target
# Cold-boot only: see system_root.mount / kaos-droid-hal-init.service.
ConditionPathExists=!/etc/kaos-overlay-active

[Mount]
What=/dev/sda15
Where=/mnt/vendor/persist
Type=ext4
Options=nosuid,nodev,barrier=1
TimeoutSec=5

[Install]
WantedBy=local-fs.target
