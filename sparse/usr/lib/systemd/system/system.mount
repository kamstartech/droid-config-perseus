[Unit]
Description=Droid mount for /system
After=system_root.mount
Requires=system_root.mount
Before=local-fs.target systemd-modules-load.service
# Cold-boot only: see system_root.mount / kaos-droid-hal-init.service.
ConditionPathExists=!/etc/kaos-overlay-active

[Mount]
What=/system_root/system
Where=/system
Type=none
Options=bind
TimeoutSec=10

[Install]
WantedBy=local-fs.target
