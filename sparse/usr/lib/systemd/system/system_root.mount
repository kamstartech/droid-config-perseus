[Unit]
Description=Droid mount for /system_root
DefaultDependencies=no
Before=local-fs.target systemd-modules-load.service
# Cold-boot only: this rootfs also boots under kaos-service's overlay/
# namespace mode, where Android already has these partitions mounted for
# real. See kaos-droid-hal-init.service for the full rationale.
ConditionPathExists=!/etc/kaos-overlay-active

[Mount]
What=/run/droid/system
Where=/system_root
Type=ext4
Options=ro,barrier=1,discard
TimeoutSec=10

[Install]
WantedBy=local-fs.target
