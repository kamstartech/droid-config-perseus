[Unit]
Description=droid-hal-init
Wants=systemd-udev-settle.service
After=local-fs.target systemd-modules-load.service systemd-udev-settle.service systemd-tmpfiles-setup.service droid-hal-prepare.service
Requires=droid-hal-prepare.service
Before=basic.target network.target bluetooth.service ofono.service sensorfwd.service
DefaultDependencies=no
Conflicts=shutdown.target
# Lets not do Requires= here as that means that this service will restart which leads automatically
# to broken state as android init can be only started once per boot. If something goes wrong
# our best hope is that android init doesn't notice that and that the crashing party fixes itself :)

[Service]
Type=notify
NotifyAccess=all
# Intentionally un-sandboxed: droid-hal-startup.sh mounts tmpfs on /data and /apex,
# bind-mounts stubs over Android graphics services, and needs full access to the
# Android partition layout prepared by droid-hal-prepare.service.
ExecStart=/bin/sh /usr/bin/droid/droid-hal-startup.sh
ExecStop=/bin/sh /usr/bin/droid/droid-hal-shutdown.sh
Restart=always
# vendor.adsprpcd starts at t~30s, adsprpc-smd opens at t~32s, APR UP at t~92s.
# startup.sh sends READY at ~t=105s (adsprpc + 70s). 180s gives 75s safety margin.
TimeoutSec=180
StartLimitInterval=60
StartLimitBurst=2

[Install]
WantedBy=graphical.target
