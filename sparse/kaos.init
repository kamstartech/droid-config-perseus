#!/bin/sh
# kaos.init — cold-boot adapter. Runs from the trampoline
# (system/extras/multirom/trampoline/trampoline.c, cold_boot_pivot_root())
# inside the target rootfs, after pivot_root and before the distro's init
# execs. Two jobs:
#
#   1. dm refresh — expose the dm-linear dynamic-partition devices Android's
#      own first-stage init already created (system/vendor/product/odm/
#      system_ext) as /dev/mapper/<name> and /run/droid/<name>.
#   2. boot adaptation — feature-detect what the distro already provides and
#      fill only the gaps, using the distro's own system scripts (systemd
#      units), so a distro doesn't have to ship Kaos-specific wiring to boot
#      here. Distros that bring their own setup (SailfishOS: native systemd
#      .mount units + lipstick) are detected and left untouched.
#
# Shared, byte-identical logic used two ways in this project:
#   - SailfishOS: this file IS /kaos.init directly (hybris/droid-configs/
#     sparse/kaos.init) -- trampoline execs it before systemd starts, and
#     SailfishOS's own native systemd .mount units do the actual mounting
#     from /run/droid/<name> afterward.
#   - Droidian/Ubuntu Touch: this file is droid-dm-setup.sh (kaos/apps/
#     phosh-app/res/raw/droid_dm_setup.sh), called as the first step of
#     mount-android-system.sh (itself deployed as /kaos.init for those
#     distros), which does its own additional /android/* mounting on top.
#
# Keep both copies in sync -- there is no automated single-source step
# between the two separate build/packaging systems these live in.
#
# Constructs NO dm-linear table itself -- there's nothing to compute here
# that the kernel doesn't already have. trampoline's hook point
# (run_init_second_stage()) fires after Android's real first-stage init has
# already done dynamic-partition resolution and created the real dm-N
# devices, on every boot, cold or warm, unconditionally. An earlier version
# of this file (both copies) instead hardcoded a per-device dm-linear table
# "captured from Android dmctl output on perseus" and tried to recreate it
# via dmsetup create -- confirmed live (2026-08-18) that table had already
# drifted from reality (live `dmctl table system` showed 4 segments
# totaling 2252832 sectors on major:minor 259:39; the hardcoded table
# claimed a single 2246232-sector segment on /dev/block/sde48) and was
# never actually being applied anyway: the dmsetup create calls always hit
# the already-real devices and failed with EBUSY, silently falling through
# to the refresh_nodes() logic below. Removed the hardcoded table and
# everything that only existed to support it, rather than fixing it.

log() {
    echo "[kaos-dm-refresh] $*" > /dev/kmsg 2>/dev/null
    echo "[kaos-dm-refresh] $*"
    # Persistent trace: /var/log lives on the distro rootfs (on /data), so this
    # survives a failed cold boot rebooting back to Android, where dmesg no
    # longer holds the pre-systemd ring buffer.
    mkdir -p /var/log 2>/dev/null
    echo "[kaos-dm-refresh] $*" >> /var/log/kaos-coldboot.log 2>/dev/null
}

refresh_nodes() {
    mkdir -p /dev/block/mapper /dev/mapper /run/droid
    for p in /sys/block/dm-*/dm/name; do
        [ -f "$p" ] || continue
        local n dm_num major minor id
        n=$(cat "$p")
        [ -n "$n" ] || continue
        dm_num=$(basename "$(dirname "$(dirname "$p")")" | sed 's/dm-//')
        id=$(cat "/sys/block/dm-$dm_num/dev" 2>/dev/null)
        major=${id%%:*}
        minor=${id#*:}
        [ -b "/dev/block/dm-$dm_num" ] || mknod "/dev/block/dm-$dm_num" b "$major" "$minor" 2>/dev/null
        # /dev/mapper/ is only ONE level under /dev/ -- a "../../" here
        # resolves to /block/dm-N (missing /dev), a dangling symlink.
        # Confirmed via a real boot (Droidian, pre-unification) that this
        # exact mistake made every /dev/mapper/* entry dangle despite
        # ls/stat on the symlink itself looking fine, since neither
        # dereferences the target by default.
        ln -sf "../block/dm-$dm_num" "/dev/mapper/$n" 2>/dev/null || true
        ln -sf "/dev/mapper/$n" "/run/droid/$n" 2>/dev/null || true
        # Re-emit uevent so systemd-udevd (which started after Android init created
        # these dm devices) notices them and populates dev-dm-X.device units.
        printf add > "/sys/block/dm-$dm_num/uevent" 2>/dev/null && log "uevent add dm-$dm_num ($n)"
    done
}

# --- Boot adaptation (feature-detected, distro-agnostic) -----------------
# Fill only what the distro is missing so it starts its session here, using
# the distro's own systemd units. Device constants come from
# /usr/local/share/kaos/device.conf (seeded by the rootfs build); perseus
# defaults apply when it is absent. Cold boot owns these files: this writes
# the DRM path, and a later warm namespace start rewrites them for the
# overlay/headless path (kaos-service), so the last writer always matches the
# mode actually booting.
adapt_boot() {
    [ -f /usr/local/share/kaos/device.conf ] && \
        . /usr/local/share/kaos/device.conf
    : "${DEV_DRM_CARD:=/dev/dri/card0}"
    : "${DEV_DRM_CARD_MAJOR:=226}"
    : "${DEV_DRM_CARD_MINOR:=0}"
    : "${DEV_DRM_RENDER:=/dev/dri/renderD128}"
    : "${DEV_DRM_RENDER_MAJOR:=226}"
    : "${DEV_DRM_RENDER_MINOR:=128}"
    : "${DEV_DISPLAY_SIZE:=1080x2340}"

    # Only systemd distros are adapted; anything else boots via its own init
    # (or the kaos-init fallback) and is left alone.
    [ -x /usr/lib/systemd/systemd ] || { log "boot: no systemd -- no adaptation"; return 0; }

    # SELinux: this kernel boots Android's SELinux in permissive mode and the
    # distro has no policy installed. Without /etc/selinux/config, libselinux/
    # systemd try to load a policy that isn't there and systemd dies at startup
    # (confirmed: an ubuntu cold boot got only
    #   "SELinux: Could not open policy file <= /etc/selinux/targeted/policy/policy.33"
    # in boot.log, then no journald/no session). SailfishOS ships
    # SELINUX=disabled and cold-boots fine -- give any distro that has SELinux
    # userspace but no config the same setting.
    if [ -d /etc/selinux ] && [ ! -e /etc/selinux/config ]; then
        echo 'SELINUX=disabled' > /etc/selinux/config
        log "boot: wrote /etc/selinux/config (disabled)"
    fi

    # Persistent kmsg capture + verbose early systemd logging. Confirmed
    # live 2026-09-26: a failed Kali cold boot got all the way through this
    # whole script (dm-refresh and adaptation both completed cleanly) but
    # left ZERO trace anywhere that survives the automatic fallback-to-
    # Android reboot that follows a failed boot -- the journal never got
    # past an empty directory (systemd/PID1 crashed or looped before its
    # first disk flush), and dmesg's ring buffer is gone the moment
    # Android's own kernel log takes over post-fallback. Neither problem
    # touches a file on THIS rootfs's own /var/log, though -- that's on
    # /data, and survives a failed boot exactly the way kaos-coldboot.log
    # (written by log(), above) already does. Start a background kmsg
    # reader now, before handing off to the real init, so whatever
    # systemd/PID1 emits from this point forward -- including a kernel
    # panic message, were one to happen -- lands in a file readable
    # afterward via adb. setsid detaches it from this script's own
    # session; neither this script exiting nor trampoline's later
    # execv(init) kills an already-running child, so it keeps tailing
    # /dev/kmsg straight through the systemd handoff.
    if [ -e /dev/kmsg ]; then
        : > /var/log/kaos-boot-kmsg.log
        setsid sh -c 'exec cat /dev/kmsg >> /var/log/kaos-boot-kmsg.log 2>&1' &
        log "boot: started persistent kmsg logger (pid $!)"
    fi

    # Make systemd itself as verbose as possible and point it at kmsg
    # (which the logger above is now capturing) rather than relying on
    # journald's own on-disk write path -- the thing that just failed to
    # produce anything at all on the boot this is responding to.
    mkdir -p /etc/systemd/system.conf.d
    {
        echo '[Manager]'
        echo 'LogLevel=debug'
        echo 'LogTarget=kmsg'
    } > /etc/systemd/system.conf.d/90-kaos-debug-logging.conf
    log "boot: wrote verbose systemd logging config (debug, kmsg target)"

    # SailfishOS is self-managed (lipstick compositor + native .mount units).
    if [ -e /usr/bin/lipstick ] || grep -qs '^ID=sailfishos' /etc/os-release 2>/dev/null; then
        log "boot: self-managed distro -- no adaptation"
        return 0
    fi

    # Phosh distro that ships phosh.service: make sure it actually starts on
    # boot and has the KGSL/DRM environment this device needs.
    if [ -e /usr/lib/systemd/system/phosh.service ]; then
        # DRM nodes: in the cold path /dev is a fresh devtmpfs, so card0/
        # renderD128 exist as root:root 0600 -- but phoc runs as uid 1000 and
        # must open them ("Failed to open /dev/dri/renderD128: Permission
        # denied" -> "no DRM FD available" -> phoc exits 1). Create-if-missing
        # from the device declaration and relax perms, mirroring the overlay
        # path's ns-entry.sh mknod.
        mkdir -p /dev/dri 2>/dev/null
        [ -e "$DEV_DRM_CARD" ] || mknod -m 0666 "$DEV_DRM_CARD" c \
            "$DEV_DRM_CARD_MAJOR" "$DEV_DRM_CARD_MINOR" 2>/dev/null
        [ -e "$DEV_DRM_RENDER" ] || mknod -m 0666 "$DEV_DRM_RENDER" c \
            "$DEV_DRM_RENDER_MAJOR" "$DEV_DRM_RENDER_MINOR" 2>/dev/null
        chmod 0666 "$DEV_DRM_CARD" "$DEV_DRM_RENDER" 2>/dev/null
        log "boot: DRM nodes ready ($DEV_DRM_CARD, $DEV_DRM_RENDER)"

        # systemd-udevd then re-applies 50-udev-default.rules: renderD* becomes
        # GROUP="render" MODE="0660" (card0 is GROUP="video"). phoc runs as
        # uid 1000, which is in 'video' but not 'render' -> "Failed to open
        # /dev/dri/renderD128: Permission denied" -> "no DRM FD available".
        # Add the uid-1000 user to 'render' when that group exists (overlay
        # sidesteps this with a fake-seat shim; the cold path opens the real
        # nodes).
        if getent group render >/dev/null 2>&1; then
            _u=$(getent passwd 1000 2>/dev/null | cut -d: -f1)
            if [ -n "$_u" ] && ! id -nG "$_u" 2>/dev/null | grep -qw render; then
                { usermod -aG render "$_u" 2>/dev/null || gpasswd -a "$_u" render >/dev/null 2>&1; } && \
                    log "boot: added $_u to render group"
            fi
        fi

        # /dev/input/eventN nodes are still owned by the numeric gid Android's
        # own ueventd assigned them at devtmpfs creation time (AID_INPUT=1004)
        # -- this rootfs's own /etc/group is a completely separate table from
        # Android's AID list and happened to assign the NAME "input" to a
        # different NUMBER (995, Debian's own convention). Adding uid 1000 to
        # that gid-995 "input" group (tried first, 2026-09-24) had zero effect
        # for exactly this reason: the kernel DAC check compares the
        # process's supplementary gid NUMBERS against the inode's gid NUMBER,
        # and 995 never matched the 1004 actually on the node -- confirmed via
        # `stat -c %g /dev/input/event0` = 1004 vs this rootfs's own
        # `getent group input` = ...:995:..., plus a dmesg capture that same
        # boot showing no SELinux avc denial for chr_file/input at all (ruled
        # that out as a possible cause first).
        # SailfishOS's own /etc/group (checked directly, same device) doesn't
        # work around this with a chmod or an ACL -- it just renumbers the
        # groups that gate Android-inherited /dev nodes to match Android's
        # own AID table exactly: input:x:1004:defaultuser,
        # audio:x:1005:pulse,defaultuser, camera:x:1006:defaultuser (video
        # stays at Debian's own 44 there too -- /dev/dri isn't Android-AID-
        # numbered the same way, so this treatment is only for the groups
        # that actually need to match an Android-created node's gid).
        # Matching that exactly, not inventing a different mechanism.
        align_android_gid() {
            # $1 = group name Android uses (also this rootfs's own name for
            # it, when one already exists), $2 = Android's AID_* gid number.
            _name="$1"; _gid="$2"
            _u=$(getent passwd 1000 2>/dev/null | cut -d: -f1)
            [ -n "$_u" ] || return 0
            _existing_by_name=$(getent group "$_name" 2>/dev/null | cut -d: -f3)
            _existing_by_gid=$(getent group "$_gid" 2>/dev/null | cut -d: -f1)
            if [ -n "$_existing_by_gid" ]; then
                # A group already sits on this exact gid (possibly $_name
                # itself, already correct from a prior boot) -- just ensure
                # membership.
                if ! id -nG "$_u" 2>/dev/null | grep -qw "$_existing_by_gid"; then
                    { usermod -aG "$_existing_by_gid" "$_u" 2>/dev/null || \
                      gpasswd -a "$_u" "$_existing_by_gid" >/dev/null 2>&1; } && \
                        log "boot: added $_u to $_existing_by_gid (gid $_gid)"
                fi
            elif [ -n "$_existing_by_name" ]; then
                # $_name exists but under Debian's own (wrong) gid -- renumber
                # it, same as SailfishOS's own table has it. groupmod only
                # changes the /etc/group entry, not any filesystem owner --
                # nothing on this rootfs is owned by the old gid, so there's
                # nothing to chown.
                groupmod -g "$_gid" "$_name" 2>/dev/null && \
                    log "boot: renumbered $_name group $_existing_by_name -> $_gid (matches Android AID)"
                if ! id -nG "$_u" 2>/dev/null | grep -qw "$_name"; then
                    { usermod -aG "$_name" "$_u" 2>/dev/null || gpasswd -a "$_u" "$_name" >/dev/null 2>&1; } && \
                        log "boot: added $_u to $_name (gid $_gid)"
                fi
            else
                # Doesn't exist at all under either name or gid (e.g. this
                # rootfs has no 'camera' group by default) -- create it.
                groupadd -g "$_gid" "$_name" 2>/dev/null && \
                    log "boot: created $_name group at gid $_gid (matches Android AID)"
                { usermod -aG "$_name" "$_u" 2>/dev/null || gpasswd -a "$_u" "$_name" >/dev/null 2>&1; } && \
                    log "boot: added $_u to $_name (gid $_gid)"
            fi
        }
        align_android_gid input 1004
        align_android_gid audio 1005
        align_android_gid camera 1006

        mkdir -p /etc/systemd/system/graphical.target.wants
        if [ ! -e /etc/systemd/system/graphical.target.wants/phosh.service ]; then
            ln -sf /usr/lib/systemd/system/phosh.service \
                /etc/systemd/system/graphical.target.wants/phosh.service
            log "boot: enabled phosh.service on graphical.target"
        fi
        mkdir -p /etc/systemd/system/phosh.service.d
        {
            echo '# Written by /kaos.init at cold boot (DRM path). The warm'
            echo '# namespace path rewrites this file for overlay/headless.'
            echo '[Unit]'
            echo 'ConditionPathExists='
            echo 'After=systemd-logind.service'
            echo 'Wants=systemd-logind.service'
            echo '[Service]'
            # TEMPORARY DIAGNOSTIC (2026-09-25, remove once the SIGSEGV below
            # is root-caused): the base unit's own ExecStart
            # (capsh --noamb -- -c "exec /usr/bin/phosh-session") execs
            # through phosh-session before reaching phoc, and cold-boot has
            # no adb access at all once switch_root replaces Android's own
            # userspace (adbd goes with it) -- there is no way to attach a
            # live debugger mid-boot the way overlay mode's own SSH access
            # allowed. Overlay mode's manual reproduction already confirmed
            # running plain /usr/bin/phoc directly (no phosh-session/capsh)
            # reproduces the identical SIGSEGV, so this bypasses the wrapper
            # chain and runs phoc under gdb in batch mode instead: it starts
            # phoc, catches the SIGSEGV when it happens, and dumps a full
            # backtrace (all threads) into the same StandardOutput log file
            # below, readable via adb once the device bounces back to
            # Android. No live interaction needed. Clear the base unit's own
            # ExecStart first (a bare "ExecStart=" line does this in a
            # drop-in) before setting this replacement.
            #
            # REVISED 2026-09-25 after the first attempt's own result: running
            # plain /usr/bin/phoc directly under gdb (bypassing phosh-session/
            # capsh entirely, as below) did NOT reproduce the crash at all --
            # it ran cleanly the whole boot with no SIGSEGV. So the crash is
            # specifically triggered by something in the phosh-session/
            # gnome-session wrapping layer, not phoc in isolation (this
            # contradicts what overlay mode's OWN manual reproduction showed,
            # but that was a different renderer path -- Mesa/Zink, not
            # hwcomposer -- so evidently a different bug). Wrapping the WHOLE
            # chain in one gdb invocation isn't reliable either: phosh-
            # session forks through several intermediate children (dbus,
            # keyring, autostart helpers, gnome-session-binary) before phoc
            # exists at all, and gdb's own fork-following is fragile with
            # that many unrelated children. Instead: start the REAL chain
            # exactly as production does (capsh included, for fidelity),
            # poll for a process literally named "phoc" by name, and attach
            # gdb fresh the moment it exists -- sidesteps fork-following
            # entirely.
            mkdir -p /usr/local/bin
            cat > /usr/local/bin/kaos-phoc-gdb-catch.sh <<'GDBEOF'
#!/bin/sh
capsh --noamb -- -c "exec /usr/bin/phosh-session" &
SESSION_PID=$!
for _i in $(seq 1 200); do
    PHOC_PID=$(pgrep -x phoc 2>/dev/null | head -n1)
    [ -n "$PHOC_PID" ] && break
    sleep 0.2
done
if [ -n "$PHOC_PID" ]; then
    echo "kaos-phoc-gdb-catch: attaching gdb to phoc pid $PHOC_PID"
    export DEBUGINFOD_URLS="https://debuginfod.ubuntu.com"
    gdb -p "$PHOC_PID" -batch \
        -iex "set debuginfod enabled on" \
        -ex "handle SIGSEGV stop print" \
        -ex continue \
        -ex "bt full" \
        -ex "thread apply all bt" \
        -ex quit
else
    echo "kaos-phoc-gdb-catch: phoc never appeared after 40s"
fi
wait "$SESSION_PID"
GDBEOF
            chmod +x /usr/local/bin/kaos-phoc-gdb-catch.sh
            echo 'ExecStart='
            echo 'ExecStart=/usr/local/bin/kaos-phoc-gdb-catch.sh'
            # Confirmed live: phoc crashes (first attempt SIGBUS, every
            # restart after that a clean exit 1) with zero captured output
            # under any journal tag, despite WLR_LOG=debug below and
            # phosh-session exec'ing phoc directly (inherited fds, not a
            # forked child) -- likely lost to stdio buffering on the crash
            # path. Force it to a real file so the buffering doesn't matter.
            echo 'StandardOutput=append:/var/log/kaos-phoc-debug.log'
            echo 'StandardError=append:/var/log/kaos-phoc-debug.log'
            # Enable real core dumps for this service specifically.
            # Confirmed live 2026-09-24: after the surfaceflinger/disabled-
            # services fix, phoc now reaches "Enabling shell mode" cleanly
            # and runs for ~25s before dying with a genuine SIGSEGV every
            # single restart, with zero log output pointing at why (unlike
            # the earlier native-window bug, which had explicit CRITICAL
            # lines first). ulimit -c defaults to 0 for systemd services
            # (ResourceLimits default), so systemd's own "code=dumped"
            # result label does NOT mean an actual core file exists --
            # confirmed by checking /var/lib/systemd/coredump/ (empty) and
            # ~defaultuser/core (kernel.core_pattern="core", i.e. cwd) after
            # an earlier SIGSEGV-generating boot, neither had anything.
            # LimitCORE=infinity plus a deterministic core_pattern (set in
            # kaos-droid-hal-prepare.sh, before this service ever starts)
            # gives the next crash somewhere to actually land, so a real
            # backtrace (gdb) becomes possible instead of guessing blind.
            echo 'LimitCORE=infinity'
            # Switched 2026-09-24 from the DRM/KGSL/Mesa/zink path (the
            # comment this replaced called it "proven-working" -- it wasn't:
            # phoc's swapchain allocation against the DRM render node always
            # failed, root-caused this session to a genuine missing
            # KGSL<->DRM interop bridge that never existed in this tree --
            # see kaos/SESSION_HANDOFF_2026-09-23.md). The hwcomposer
            # backend (our wlroots-hwcomposer fork, hybris/mw/wlroots-
            # hwcomposer) renders through the real Android HWComposer HIDL
            # service via libhybris instead, the same approach SailfishOS's
            # lipstick already uses successfully on this device
            # (EGL_PLATFORM=hwcomposer). No DRM/GBM/Mesa/Vulkan env needed --
            # this backend never touches /dev/dri at all.
            echo 'Environment=WLR_BACKENDS=hwcomposer,libinput'
            echo 'Environment=WLR_LOG=debug'
            echo 'Environment=PHOC_DEBUG=auto-maximize'
            echo 'Environment=WLR_RENDERER=gles2'
            echo 'Environment=EGL_PLATFORM=hwcomposer'
            # HYBRIS_USE_VENDOR_NAMESPACE: root-caused 2026-09-24, after the
            # Type=notify/HWComposer-poll structural fix (matching Sailfish's
            # droid-hal-startup.sh) STILL produced the identical
            # "not accessible for the namespace (default)" error for
            # /vendor/lib64/egl/libGLESv2_adreno.so, proving every earlier
            # fix (persist-restore, real re-mount, real apexd activation,
            # dir.system patch, /linkerconfig/default population,
            # HYBRIS_BUILD stub binary, Type=notify sequencing) was correct
            # on its own terms but irrelevant to the actual failure.
            # Traced into libhybris source (hybris/mw/libhybris/libhybris/
            # hybris/common/q/linker_main.cpp get_executable_path(),
            # DISABLED_FOR_HYBRIS_SUPPORT branch): this device's SDK version
            # (35) selects the "q" linker backend (hybris/common/hooks.c
            # __hybris_linker_init(), sdk_version<=29 threshold, q is the
            # newest/default backend for anything newer). That backend does
            # NOT use /proc/self/exe for its own self-identity when matching
            # dir.system/dir.vendor rules in ld.config.txt -- it's hardcoded
            # to always claim to be /system/bin/app_process64 (the classic
            # Halium-era "pretend to be zygote" trick), UNLESS this exact
            # env var is set, in which case it claims /vendor/bin/yes
            # instead. Confirmed by diffing the real, persisted, genuine
            # Android-15-generated /mnt/vendor/persist/ld.config.txt: the
            # [system] section's own namespace.default (what app_process64
            # resolves into, isolated=true) has NO /vendor/${LIB}/egl in its
            # search or permitted paths at all -- modern Treble intentionally
            # keeps ordinary system-partition processes away from vendor GPU
            # driver internals. The [vendor] section's own namespace.default
            # explicitly has search.paths += /vendor/${LIB}/egl and
            # permitted.paths += /vendor -- exactly what libGLESv2_adreno.so
            # needs, and exactly what SailfishOS's own lipstick presumably
            # gets for free by a different route. Every prior fix targeted
            # droid-hal-init's OWN real linkerconfig generation, which was
            # never wrong -- phoc was reading that real, correctly-generated
            # file the whole time, just being classified into the wrong
            # (system, not vendor) section of it by libhybris's own
            # hardcoded self-impersonation, independent of anything
            # droid-hal-init does.
            echo 'Environment=HYBRIS_USE_VENDOR_NAMESPACE=1'
            # libhybris's own libEGL.so/libGLESv2.so live in /usr/lib/hybris,
            # deliberately isolated from apt's Mesa EGL/GLESv2 (same SONAME,
            # incompatible implementations -- Mesa's libEGL doesn't know
            # EGL_PLATFORM=hwcomposer and falls back to trying X11).
            # Confirmed live 2026-09-24: without this, phoc loaded Mesa's
            # libEGL and failed with "invalid EGL_PLATFORM given" ->
            # "xcb_connect failed". This is what actually decides which one
            # wins for phoc, not ldconfig's default search order.
            echo 'Environment=LD_LIBRARY_PATH=/usr/lib/hybris'
            # Seat: no seatd is installed and logind has no real VT here, so
            # phoc cannot acquire a seat on its own. Use the same
            # kaos-libseat-fake shim as the overlay path; it hands wlroots the
            # real /dev/dri/card* for the DRM backend (see kaos-libseat-fake.c
            # libseat_open_device).
            echo 'Environment=LIBSEAT_BACKEND=logind'
            echo 'Environment=LD_PRELOAD=/usr/local/lib/kaos-libseat-fake.so'
            echo 'Environment=XDG_SEAT=seat0'
        } > /etc/systemd/system/phosh.service.d/kaos.conf
        log "boot: wrote cold-boot phosh environment"

        mkdir -p /etc/phosh
        {
            echo '[core]'
            echo 'xwayland=false'
            echo
            # wlroots' hwcomposer backend names its (only) output
            # "HWCOMPOSER-<display+1>" (backend/hwcomposer/output.c) -- not
            # a DRM/KMS connector name like "DSI-1", which was specific to
            # the DRM backend this replaced.
            echo '[output:HWCOMPOSER-1]'
            echo "mode = $DEV_DISPLAY_SIZE"
            echo 'scale = 2'
        } > /etc/phosh/phoc.ini
        log "boot: wrote phoc.ini (HWCOMPOSER-1 $DEV_DISPLAY_SIZE)"

        # Cold boot uses the hwcomposer backend, not the overlay frame relay.
        # Drop any relay wiring left by a previous warm start (kaos-service
        # rewrites all of it on its next start), so this session isn't
        # fought by a capture client whose OnFailure restarts phosh.
        rm -f /etc/systemd/system/phosh.service.wants/kaos-ui-stream.service \
              /etc/systemd/system/graphical.target.wants/kaos-ui-stream.service \
              /etc/systemd/system/kaos-ui-stream.service \
              /etc/systemd/system/kaos-ui-stream-recover.service
        rmdir /etc/systemd/system/phosh.service.wants 2>/dev/null || true
    fi
}

log "=== START ==="

# Clear a stale overlay-mode marker from a prior kaos-service namespace
# session against this same rootfs. kaos-service's ns-entry.sh (overlay/
# namespace mode, never switch_root) touches /etc/kaos-overlay-active right
# before exec'ing real systemd, so the cold-boot-only mount/init units
# (ConditionPathExists=!/etc/kaos-overlay-active) skip themselves when run
# inside an overlay namespace instead of fighting Android's already-running
# droid-hal-init for the same HIDL/vendor-HAL registrations. This is a real
# switch_root cold boot, so that marker (if left over from an earlier
# overlay session against this same rootfs) must not survive to mask the
# units this boot path actually needs.
rm -f /etc/kaos-overlay-active 2>/dev/null || true

refresh_nodes
adapt_boot
log "=== DONE ==="
ls -la /dev/mapper/ > /dev/kmsg 2>&1 || true
